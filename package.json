{
  "name": "bonbon",
  "private": true,
  "version": "0.2.0",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch api/server.ts",
    "build": "npm run validate:markets && vue-tsc -b && tsc -p tsconfig.scripts.json && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start:api": "node api-dist/api/server.js",
    "validate:markets": "vite-node scripts/validate_market_data.mjs dataset",
    "validate:contribution": "vite-node scripts/validate_market_data.mjs contribution",
    "audit:receipts": "vite-node scripts/audit_receipts.mts",
    "import:markets": "vite-node scripts/import_market_data.mjs",
    "review:market-observations": "tsx scripts/review_market_observations.tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "better-sqlite3": "^13.0.3",
    "echarts": "^6.0.0",
    "fastify": "^5.12.1",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.2.108",
    "vue": "^3.5.21",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.1.12",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^20.12.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
